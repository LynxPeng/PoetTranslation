    {
      "id": "T05",
      "hanzi_count": 40,
      "coverage_units": [
        {
          "id": "U01",
          "text": "国破山河在"
        },
        {
          "id": "U02",
          "text": "城春草木深"
        },
        {
          "id": "U03",
          "text": "感时花溅泪"
        },
        {
          "id": "U04",
          "text": "恨别鸟惊心"
        },
        {
          "id": "U05",
          "text": "烽火连三月"
        },
        {
          "id": "U06",
          "text": "家书抵万金"
        },
        {
          "id": "U07",
          "text": "白头搔更短"
        },
        {
          "id": "U08",

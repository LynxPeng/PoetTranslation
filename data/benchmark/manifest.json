    {
      "id": "T07",
      "hanzi_count": 56,
      "coverage_units": [
        {
          "id": "U01",
          "text": "风急天高猿啸哀"
        },
        {
          "id": "U02",
          "text": "渚清沙白鸟飞回"
        },
        {
          "id": "U03",
          "text": "无边落木萧萧下"
        },
        {
          "id": "U04",
          "text": "不尽长江滚滚来"
        },
        {
          "id": "U05",
          "text": "万里悲秋常作客"
        },
        {
          "id": "U06",
          "text": "百年多病独登台"
        },
        {
          "id": "U07",
          "text": "艰难苦恨繁霜鬓"
        },
        {
          "id": "U08",
          "text": "潦倒新停浊酒杯"
        }
      ],
      "source_sha256": "598f7e62178f2b425b48baabe271c196bd9232f6f78af87217375288d9ce58e3"
    },
    {
      "id": "T08",
      "hanzi_count": 616,
      "coverage_units": [
        {
          "id": "U01",
          "text": "浔阳江头夜送客"
        },
        {
          "id": "U02",
          "text": "枫叶荻花秋瑟瑟"
        },
        {
          "id": "U03",
          "text": "主人下马客在船"
        },
        {
          "id": "U04",
          "text": "举酒欲饮无管弦"
        },
        {
          "id": "U05",
          "text": "醉不成欢惨将别"
        },
        {
          "id": "U06",
          "text": "别时茫茫江浸月"
        },
        {
          "id": "U07",
          "text": "忽闻水上琵琶声"
        },
        {
          "id": "U08",
          "text": "主人忘归客不发"
        },
        {
          "id": "U09",
          "text": "寻声暗问弹者谁"
        },
        {
          "id": "U10",
          "text": "琵琶声停欲语迟"
        },
        {
          "id": "U11",
          "text": "移船相近邀相见"
        },
        {
          "id": "U12",
          "text": "添酒回灯重开宴"
        },
        {
          "id": "U13",
          "text": "千呼万唤始出来"
        },
        {
          "id": "U14",
          "text": "犹抱琵琶半遮面"
        },
        {
          "id": "U15",
          "text": "转轴拨弦三两声"
        },
        {
          "id": "U16",
          "text": "未成曲调先有情"
        },
        {
          "id": "U17",
          "text": "弦弦掩抑声声思"
        },
        {
          "id": "U18",
          "text": "似诉平生不得志"
        },
        {
          "id": "U19",
          "text": "低眉信手续续弹"
        },
        {
          "id": "U20",
          "text": "说尽心中无限事"
        },
        {
          "id": "U21",
          "text": "轻拢慢捻抹复挑"
        },
        {
          "id": "U22",
          "text": "初为霓裳后六幺"
        },
        {
          "id": "U23",
          "text": "大弦嘈嘈如急雨"
        },
        {
          "id": "U24",
          "text": "小弦切切如私语"
        },
        {
          "id": "U25",
          "text": "嘈嘈切切错杂弹"
        },
        {
          "id": "U26",
          "text": "大珠小珠落玉盘"
        },
        {
          "id": "U27",
          "text": "间关莺语花底滑"
        },
        {
          "id": "U28",
          "text": "幽咽泉流冰下难"
        },
        {
          "id": "U29",
          "text": "冰泉冷涩弦凝绝"
        },
        {
          "id": "U30",
          "text": "凝绝不通声暂歇"
        },
        {
          "id": "U31",
          "text": "别有幽愁暗恨生"
        },
        {
          "id": "U32",
          "text": "此时无声胜有声"
        },
        {
          "id": "U33",
          "text": "银瓶乍破水浆迸"
        },
        {
          "id": "U34",
          "text": "铁骑突出刀枪鸣"
        },
        {
          "id": "U35",
          "text": "曲终收拨当心画"
        },
        {
          "id": "U36",
          "text": "四弦一声如裂帛"
        },
        {
          "id": "U37",
          "text": "东船西舫悄无言"
        },
        {
          "id": "U38",
          "text": "唯见江心秋月白"
        },
        {
          "id": "U39",
          "text": "沉吟放拨插弦中"
        },
        {
          "id": "U40",
          "text": "整顿衣裳起敛容"
        },
        {
          "id": "U41",
          "text": "自言本是京城女"
        },
        {
          "id": "U42",
          "text": "家在虾蟆陵下住"
        },
        {
          "id": "U43",
          "text": "十三学得琵琶成"
        },
        {
          "id": "U44",
          "text": "名属教坊第一部"
        },
        {
          "id": "U45",
          "text": "曲罢曾教善才服"
        },
        {
          "id": "U46",
          "text": "妆成每被秋娘妒"
        },
        {
          "id": "U47",
          "text": "五陵年少争缠头"
        },
        {
          "id": "U48",
          "text": "一曲红绡不知数"
        },
        {
          "id": "U49",
          "text": "钿头银篦击节碎"
        },
        {
          "id": "U50",
          "text": "血色罗裙翻酒污"
        },
        {
          "id": "U51",
          "text": "今年欢笑复明年"
        },
        {
          "id": "U52",
          "text": "秋月春风等闲度"
        },
        {
          "id": "U53",
          "text": "弟走从军阿姨死"
        },
        {
          "id": "U54",
          "text": "暮去朝来颜色故"
        },
        {
          "id": "U55",
          "text": "门前冷落鞍马稀"
        },
        {
          "id": "U56",
          "text": "老大嫁作商人妇"
        },
        {
          "id": "U57",
          "text": "商人重利轻别离"
        },
        {
          "id": "U58",
          "text": "前月浮梁买茶去"
        },
        {
          "id": "U59",
          "text": "去来江口守空船"
        },
        {
          "id": "U60",
          "text": "绕船月明江水寒"
        },
        {
          "id": "U61",
          "text": "夜深忽梦少年事"
        },
        {
          "id": "U62",
          "text": "梦啼妆泪红阑干"
        },
        {
          "id": "U63",
          "text": "我闻琵琶已叹息"
        },
        {
          "id": "U64",
          "text": "又闻此语重唧唧"
        },
        {
          "id": "U65",
          "text": "同是天涯沦落人"
        },
        {
          "id": "U66",
          "text": "相逢何必曾相识"
        },
        {
          "id": "U67",
          "text": "我从去年辞帝京"
        },
        {
          "id": "U68",
          "text": "谪居卧病浔阳城"
        },
        {
          "id": "U69",
          "text": "浔阳地僻无音乐"
        },
        {
          "id": "U70",
          "text": "终岁不闻丝竹声"
        },
        {
          "id": "U71",
          "text": "住近湓江地低湿"
        },
        {
          "id": "U72",
          "text": "黄芦苦竹绕宅生"
        },
        {
          "id": "U73",
          "text": "其间旦暮闻何物"
        },
        {
          "id": "U74",
          "text": "杜鹃啼血猿哀鸣"
        },
        {
          "id": "U75",
          "text": "春江花朝秋月夜"
        },
        {
          "id": "U76",
          "text": "往往取酒还独倾"
        },
        {
          "id": "U77",
          "text": "岂无山歌与村笛"
        },
        {
          "id": "U78",
          "text": "呕哑嘲哳难为听"
        },
        {
          "id": "U79",
          "text": "今夜闻君琵琶语"
        },
        {
          "id": "U80",
          "text": "如听仙乐耳暂明"
        },
        {
          "id": "U81",
          "text": "莫辞更坐弹一曲"
        },
        {
          "id": "U82",
          "text": "为君翻作琵琶行"
        },
        {
          "id": "U83",
          "text": "感我此言良久立"
        },
        {
          "id": "U84",
          "text": "却坐促弦弦转急"
        },
        {
          "id": "U85",
          "text": "凄凄不似向前声"
        },
        {
          "id": "U86",
          "text": "满座重闻皆掩泣"
        },
        {
          "id": "U87",
          "text": "座中泣下谁最多"
        },
        {
          "id": "U88",
          "text": "江州司马青衫湿"
        }
      ],
      "source_sha256": "93da78b817dd6a5ffa4bbd63f1b363b1e4ddaf68648654f2e938dad9f65f8fdd"
    },
    {
      "id": "S01",
      "hanzi_count": 33,
      "coverage_units": [
        {
          "id": "U01",
          "text": "常记溪亭日暮"
        },
        {
          "id": "U02",
          "text": "沉醉不知归路"
        },
        {
          "id": "U03",
          "text": "兴尽晚回舟"
        },
        {
          "id": "U04",
          "text": "误入藕花深处"
        },
        {
          "id": "U05",
          "text": "争渡"
        },
        {
          "id": "U06",
          "text": "争渡"
        },
        {
          "id": "U07",
          "text": "惊起一滩鸥鹭"
        }
      ],
      "source_sha256": "46bb6377ffb68d84c3277ab1830b7d6ab6456ee91ebf5f15197ac3f7b6c3d5a7"
    },
    {
      "id": "S02",
      "hanzi_count": 42,
      "coverage_units": [
        {
          "id": "U01",
          "text": "一曲新词酒一杯"
        },
        {
          "id": "U02",
          "text": "去年天气旧亭台"
        },
        {
          "id": "U03",
          "text": "夕阳西下几时回"
        },
        {
          "id": "U04",
          "text": "无可奈何花落去"
        },
        {
          "id": "U05",
          "text": "似曾相识燕归来"
        },
        {
          "id": "U06",
          "text": "小园香径独徘徊"
        }
      ],
      "source_sha256": "a8f37ae1997fe2e0354457a05e840811fe9f72a4ebccdf481f3cc63d92b7abe4"
    },
    {
      "id": "S03",
      "hanzi_count": 45,
      "coverage_units": [
        {
          "id": "U01",
          "text": "我住长江头"
        },
        {
          "id": "U02",
          "text": "君住长江尾"
        },
        {
          "id": "U03",
          "text": "日日思君不见君"
        },
        {
          "id": "U04",
          "text": "共饮长江水"
        },
        {
          "id": "U05",
          "text": "此水几时休"
        },
        {
          "id": "U06",
          "text": "此恨何时已"
        },
        {
          "id": "U07",
          "text": "只愿君心似我心"
        },
        {
          "id": "U08",
          "text": "定不负相思意"
        }
      ],
      "source_sha256": "2035791e927a07526420eaf2a1c4f9d355b17a970a46e3f2d1241b6c5fe74ff8"
    },
    {
      "id": "S04",
      "hanzi_count": 49,
      "coverage_units": [
        {
          "id": "U01",
          "text": "风住尘香花已尽"
        },
        {
          "id": "U02",
          "text": "日晚倦梳头"
        },
        {
          "id": "U03",
          "text": "物是人非事事休"
        },
        {
          "id": "U04",
          "text": "欲语泪先流"
        },
        {
          "id": "U05",
          "text": "闻说双溪春尚好"
        },
        {
          "id": "U06",
          "text": "也拟泛轻舟"
        },
        {
          "id": "U07",
          "text": "只恐双溪舴艋舟"
        },
        {
          "id": "U08",
          "text": "载不动许多愁"
        }
      ],
      "source_sha256": "2fe769af8c742162313d5541c89841bd9c0657cc2ee80b376557822a24cacdd4"
    },
    {
      "id": "S05",
      "hanzi_count": 60,
      "coverage_units": [
        {
          "id": "U01",
          "text": "伫倚危楼风细细"
        },
        {
          "id": "U02",
          "text": "望极春愁"
        },
        {
          "id": "U03",
          "text": "黯黯生天际"
        },
        {
          "id": "U04",
          "text": "草色烟光残照里"
        },
        {
          "id": "U05",
          "text": "无言谁会凭阑意"
        },
        {
          "id": "U06",
          "text": "拟把疏狂图一醉"
        },
        {
          "id": "U07",
          "text": "对酒当歌"
        },
        {
          "id": "U08",
          "text": "强乐还无味"
        },
        {
          "id": "U09",
          "text": "衣带渐宽终不悔"
        },
        {
          "id": "U10",
          "text": "为伊消得人憔悴"
        }
      ],
      "source_sha256": "c3c21b37f8b9d960ed1cdeabc41ef8010f200b22e1a21c96b21f90546888b990"
    },
    {
      "id": "S06",
      "hanzi_count": 70,
      "coverage_units": [
        {
          "id": "U01",
          "text": "十年生死两茫茫"
        },
        {
          "id": "U02",
          "text": "不思量"
        },
        {
          "id": "U03",
          "text": "自难忘"
        },
        {
          "id": "U04",
          "text": "千里孤坟"
        },
        {
          "id": "U05",
          "text": "无处话凄凉"
        },
        {
          "id": "U06",
          "text": "纵使相逢应不识"
        },
        {
          "id": "U07",
          "text": "尘满面"
        },
        {
          "id": "U08",
          "text": "鬓如霜"
        },
        {
          "id": "U09",
          "text": "夜来幽梦忽还乡"
        },
        {
          "id": "U10",
          "text": "小轩窗"
        },
        {
          "id": "U11",
          "text": "正梳妆"
        },
        {
          "id": "U12",
          "text": "相顾无言"
        },
        {
          "id": "U13",
          "text": "惟有泪千行"
        },
        {
          "id": "U14",
          "text": "料得年年肠断处"
        },
        {

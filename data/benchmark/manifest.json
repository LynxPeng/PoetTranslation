      "hanzi_count": 40,
      "coverage_units": [
        {
          "id": "U01",
          "text": "空山新雨后"
        },
        {
          "id": "U02",
          "text": "天气晚来秋"
        },
        {
          "id": "U03",
          "text": "明月松间照"
        },
        {
          "id": "U04",
          "text": "清泉石上流"
        },
        {
          "id": "U05",
          "text": "竹喧归浣女"
        },
        {
          "id": "U06",
          "text": "莲动下渔舟"
        },
        {
          "id": "U07",
          "text": "随意春芳歇"
        },
        {
          "id": "U08",

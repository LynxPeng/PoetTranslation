      },
      {
        "id": "T01-R2",
        "terms": [
          "霜"
        ],
        "text": "霜：近地面的水汽遇冷形成的白色晶体；字也可形容白色。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=9186&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://zh.wikisource.org/wiki/靜夜思",

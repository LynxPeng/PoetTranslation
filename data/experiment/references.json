      },
      {
        "id": "T05-R2",
        "terms": [
          "簪"
        ],
        "text": "簪：古代固定头发或头冠的饰物。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=9555&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://zh.wikisource.org/wiki/春望",
        "checked_on": "2026-11-01",
        "note_type": "independent_lexical_background_not_translation_answer"
      }
    ],
    "T06": [
      {
        "id": "T06-R1",
        "terms": [
          "王孙",
          "王孫"
        ],
        "text": "王孙既可指贵族后裔，也可作对人的尊称。词典多义项不能单独决定本诗所指。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=162671&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://zh.wikisource.org/wiki/山居秋暝",

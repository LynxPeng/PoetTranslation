      },
      {
        "id": "T06-R2",
        "terms": [
          "浣女",
          "浣"
        ],
        "text": "浣的动词义包括洗涤、洗濯。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=11497&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://zh.wikisource.org/wiki/山居秋暝",

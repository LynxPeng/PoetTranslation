    "T07": [
      {
        "id": "T07-R1",
        "terms": [
          "潦倒"
        ],
        "text": "潦倒有失意、不得志义，亦有其他用法；辞典在失意义项引本诗末联。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=63041&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://zh.wikisource.org/wiki/登高",

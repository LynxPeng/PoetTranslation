      }
    ],
    "T02": [
      {
        "id": "T02-R1",
        "terms": [
          "返景",
          "景"
        ],
        "text": "景有日光义；教育部异体字字典景条引《鹿柴》的返景入深林作为用例。",
        "source_url": "https://dict.variants.moe.edu.tw/dictView.jsp?ID=19996&la=1&powerMode=2",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://zh.wikisource.org/wiki/鹿柴_(王維)",
        "checked_on": "2026-11-01",
        "note_type": "independent_lexical_background_not_translation_answer"
      },
      {
        "id": "T02-R2",
        "terms": [
          "青苔",
          "苔"
        ],
        "text": "青苔：青色的苔藓。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=101961&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://zh.wikisource.org/wiki/鹿柴_(王維)",
        "checked_on": "2026-11-01",
        "note_type": "independent_lexical_background_not_translation_answer"
      }
    ],
    "T03": [
      {
        "id": "T03-R1",
        "terms": [
          "浥"
        ],
        "text": "浥：使之润湿、沾湿，辞典以渭城朝雨浥轻尘为例。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=10628&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://zh.wikisource.org/wiki/送元二使安西",
        "checked_on": "2026-11-01",
        "note_type": "independent_lexical_background_not_translation_answer"
      },
      {
        "id": "T03-R2",
        "terms": [
          "故人"
        ],
        "text": "故人有老友义，也有其他义项，须依据上下文确定。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=71541&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://zh.wikisource.org/wiki/送元二使安西",
        "checked_on": "2026-11-01",
        "note_type": "independent_lexical_background_not_translation_answer"
      }
    ],
    "T04": [
      {
        "id": "T04-R1",
        "terms": [
          "烟花",
          "煙花"
        ],
        "text": "烟花可指春花盛开、如烟似雾之景，辞典以本诗首联为例。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=154884&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://cd.edb.gov.hk/chi/resource/ncs/download/js_list/JS_huanghelousongmenghaoran.pdf",
        "checked_on": "2026-11-01",
        "note_type": "independent_lexical_background_not_translation_answer"
      },
      {
        "id": "T04-R2",
        "terms": [
          "孤帆"
        ],
        "text": "孤帆可借指孤舟。仅取词义，不采用词典引诗中的碧山异文。",
        "source_url": "https://dict.revised.moe.edu.tw/dictView.jsp?ID=70783&la=0&powerMode=0",
        "source_title": "教育部官方辞典",
        "poem_source_url": "https://cd.edb.gov.hk/chi/resource/ncs/download/js_list/JS_huanghelousongmenghaoran.pdf",
        "checked_on": "2026-11-01",
        "note_type": "independent_lexical_background_not_translation_answer"
      }
    ],
    "T05": [
      {
        "id": "T05-R1",
        "terms": [
          "烽火"
        ],
        "text": "烽火原指边防报警烟火，也用来代指战争。",
